<script>
(()=>{
const canvas=document.getElementById('space'),ctx=canvas.getContext('2d');
const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
let w=0,h=0,d=1,stars=[],bolts=[],tick=0;
function resize(){d=Math.min(devicePixelRatio||1,1.5);w=innerWidth;h=innerHeight;canvas.width=w*d;canvas.height=h*d;ctx.setTransform(d,0,0,d,0,0);stars=Array.from({length:Math.min(100,Math.floor(w*h/12000))},()=>({x:Math.random()*w,y:Math.random()*h,r:Math.random()*1.7+.4,vx:(Math.random()-.5)*.25,vy:-(Math.random()*.35+.08),a:Math.random()}))}
function bolt(){let x=Math.random()*w,y=Math.random()*h*.42,p=[{x,y}];for(let i=0;i<8;i++){x+=(Math.random()-.5)*48;y+=7+Math.random()*14;p.push({x,y})}bolts.push({p,l:1})}
function draw(){ctx.clearRect(0,0,w,h);stars.forEach(s=>{ctx.beginPath();ctx.arc(s.x,s.y,s.r,0,Math.PI*2);ctx.fillStyle=`rgba(89,218,255,${.3+s.a*.7})`;ctx.shadowBlur=10;ctx.shadowColor='#168bff';ctx.fill();if(!reduced){s.x+=s.vx;s.y+=s.vy;if(s.y<0)s.y=h;if(s.x<0)s.x=w;if(s.x>w)s.x=0}});ctx.shadowBlur=0;if(!reduced&&++tick%240===0)bolt();bolts.forEach(q=>{ctx.beginPath();q.p.forEach((p,i)=>i?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y));ctx.strokeStyle=`rgba(67,220,255,${q.l})`;ctx.lineWidth=1.5;ctx.shadowBlur=15;ctx.shadowColor='#168bff';ctx.stroke();q.l-=.06});bolts=bolts.filter(q=>q.l>0);if(!reduced)requestAnimationFrame(draw)}
addEventListener('resize',resize);resize();draw();
const menu=document.getElementById('menu'),nav=document.getElementById('nav');menu.addEventListener('click',()=>nav.classList.toggle('open'));nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>nav.classList.remove('open')));
const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');observer.unobserve(e.target)}}),{threshold:.12});document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));
const qs=[
{q:'Mục tiêu chính của an toàn thông tin là gì?',a:['Bảo vệ dữ liệu và quyền riêng tư','Chia sẻ mọi mật khẩu','Tăng độ sáng màn hình','Xóa mọi bản sao lưu'],c:0,why:'Chính xác! An toàn thông tin giúp bảo vệ tính bí mật, toàn vẹn và khả dụng của dữ liệu.'},
{q:'Khi dùng AI để làm bài tập, cách nào phù hợp nhất?',a:['Chép nguyên văn và nhận là của mình','Kiểm chứng kết quả, tự hiểu và ghi nhận hỗ trợ khi cần','Tin mọi câu trả lời của AI','Dùng AI để né mọi yêu cầu học tập'],c:1,why:'Đúng! Hãy xem AI là công cụ hỗ trợ, kiểm tra thông tin và chịu trách nhiệm với bài làm.'},
{q:'HTML chủ yếu dùng để làm gì?',a:['Tạo cấu trúc nội dung trang web','Sạc pin máy tính','Quét virus tự động','Thay thế hệ điều hành'],c:0,why:'Đúng! HTML mô tả cấu trúc và nội dung của trang web.'},
{q:'Bạn nhận được liên kết lạ yêu cầu đăng nhập. Nên làm gì?',a:['Nhập mật khẩu ngay','Chuyển tiếp cho cả lớp','Kiểm tra nguồn gửi và địa chỉ trang trước khi mở','Gửi mã xác thực cho người gửi'],c:2,why:'Chính xác! Không vội nhấp liên kết hoặc cung cấp mật khẩu, mã xác thực cho người khác.'}
];
let qi=0,score=0,answered=false;
const question=document.getElementById('question'),answers=document.getElementById('answers'),feedback=document.getElementById('feedback'),next=document.getElementById('next'),counter=document.getElementById('counter');
function show(){answered=false;const q=qs[qi];counter.textContent=`CÂU HỎI ${String(qi+1).padStart(2,'0')} / ${String(qs.length).padStart(2,'0')}`;question.textContent=q.q;feedback.textContent='';next.hidden=true;answers.innerHTML='';q.a.forEach((label,i)=>{const btn=document.createElement('button');btn.className='answer';btn.textContent=String.fromCharCode(65+i)+'. '+label;btn.addEventListener('click',()=>{if(answered)return;answered=true;[...answers.children].forEach((el,j)=>{el.disabled=true;if(j===q.c)el.classList.add('correct')});if(i===q.c){score++;feedback.textContent='✓ '+q.why}else{btn.classList.add('wrong');feedback.textContent='Chưa đúng. '+q.why}next.hidden=false;next.textContent=qi===qs.length-1?'Xem kết quả →':'Câu tiếp theo →'});answers.appendChild(btn)})}
next.addEventListener('click',()=>{if(qi<qs.length-1){qi++;show()}else{counter.textContent='HOÀN THÀNH';question.textContent=`Bạn trả lời đúng ${score}/${qs.length} câu!`;answers.innerHTML='';feedback.textContent=score===qs.length?'Tuyệt vời! Bạn đã nắm vững các kiến thức cơ bản.':'Hãy xem lại các chủ đề phía trên rồi thử lại nhé.';next.textContent='Làm lại ↻';next.onclick=()=>{qi=0;score=0;next.onclick=null;show()}}});
show();
})();
</script>
</body>
</html>
